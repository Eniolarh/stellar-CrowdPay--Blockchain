# docker compose variable substitution ONLY.
#
#   cp .env.example .env
#
# Application configuration lives in backend/.env.example, which is the single
# source of truth for every backend variable. This file only provides the
# database container credentials used by docker-compose.yml. They must match
# the user, password and database in DATABASE_URL in backend/.env.
# backend/src/config/envExample.test.js keeps the two files in sync.
POSTGRES_DB=crowdpay
POSTGRES_USER=crowdpay
POSTGRES_PASSWORD=crowdpay