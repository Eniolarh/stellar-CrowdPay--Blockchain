# Backend API base URL (used in production; Vite proxies /api in development)
VITE_API_BASE_URL=http://localhost:3001

# Stellar network for block explorer links
VITE_STELLAR_NETWORK=testnet

# Leave empty for local development (Vite proxies /api to the backend automatically)
# Set to the backend's public origin for production builds, for example https://api.yourcrowdpay.com
VITE_API_BASE_URL=
# Set to false to skip KYC gate in the frontend (mirrors backend KYC_REQUIRED_FOR_CAMPAIGNS)
# VITE_KYC_REQUIRED_FOR_CAMPAIGNS=false

# ── Error tracking (Sentry) ───────────────────────────────
# Get DSN from sentry.io project settings. Leave empty to disable.
VITE_SENTRY_DSN=

# ── Production CSP extra origins ─────────────────────────
# These are injected by docker-entrypoint.sh into the nginx CSP header at
# container start time.  Leave empty for local development.
#
# Sentry ingest origin – added to connect-src.
# Derive from VITE_SENTRY_DSN: take the scheme+host of the DSN URL.
# Example: https://o123456.ingest.sentry.io
CSP_SENTRY_ORIGIN=
#
# Space-separated extra hosts added to img-src (CDN, S3, etc.).
# Example: https://cdn.example.com https://your-bucket.s3.amazonaws.com
CSP_IMG_HOSTS=
